rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read and write only their own progress document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Push subscriptions for daily reminders, one doc per device. Only the owner writes them;
    // the reminder job (.github/workflows/remind.yml) reads them with a service account.
    match /users/{uid}/push/{device} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
